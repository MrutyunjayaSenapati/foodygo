{
  "expo": {
    "name": "FoodyGo Delivery",
    "slug": "foodygo-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "foodygo-delivery",
    "platforms": ["ios", "android"],
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodygo.delivery",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#007AFF"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#007AFF"
      },
      "package": "com.foodygo.delivery",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#007AFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ]
  }
}
